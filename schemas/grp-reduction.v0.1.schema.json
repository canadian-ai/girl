{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/canadian-ai/girl/schemas/grp-reduction.v0.1.schema.json",
  "title": "GRP Reduction",
  "description": "GRP Core software graph reduction/collection metadata: semantic node identity, canonical targets, reference evidence, and compression blocks.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^cap_" },
          "kind": { "type": "string" },
          "garbageClass": {
            "type": "string",
            "enum": ["unreachable", "duplicate", "obsolete", "redundant", "dead-api", "dead-policy", "dead-schema-field", "dead-dependency-adapter"]
          },
          "canonicalID": { "type": "string", "pattern": "^cap_" },
          "reachable": { "type": "boolean" },
          "refCount": { "type": "integer", "minimum": 0 },
          "symbol": { "type": "string" },
          "file": { "type": "string" },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "kind": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 }
              },
              "required": ["from", "to"]
            }
          },
          "metadata": { "type": "object" }
        },
        "required": ["id"]
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^blk_" },
          "capabilityId": { "type": "string", "pattern": "^cap_" },
          "standard": { "type": "boolean" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "nodes": { "type": "array", "items": { "type": "string", "pattern": "^cap_" } }
        },
        "required": ["id"]
      }
    }
  }
}